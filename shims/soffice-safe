#!/bin/sh
# soffice-safe: headless LibreOffice that is safe for agents.
# Generated by `unienv sync`.
#
# Plain `soffice` shares one user profile per machine. A second concurrent call
# silently does nothing (LibreOffice bug 37531), and in sandboxes the profile
# cannot be created at all ("User installation could not be completed").
# This wrapper gives every call its own throwaway profile and removes it after.
#
#   soffice-safe --convert-to pdf --outdir out/ report.docx
SOFFICE="${UNIENV_SOFFICE:-}"
if [ -z "$SOFFICE" ]; then
  for c in "/Applications/LibreOffice.app/Contents/MacOS/soffice" \
           "$(command -v soffice 2>/dev/null)" \
           "$(command -v libreoffice 2>/dev/null)"; do
    if [ -n "$c" ] && [ -x "$c" ]; then SOFFICE="$c"; break; fi
  done
fi
if [ -z "$SOFFICE" ]; then
  echo "soffice-safe: LibreOffice is not installed. Run: unienv need --cask libreoffice" >&2
  exit 127
fi

PROFILE="$(mktemp -d "${TMPDIR:-/tmp}/ue_lo.XXXXXX")"
trap 'rm -rf "$PROFILE"' EXIT INT TERM
"$SOFFICE" "-env:UserInstallation=file://$PROFILE" \
  --headless --invisible --norestore --nologo --nodefault --nolockcheck "$@"
