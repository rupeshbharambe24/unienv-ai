#!/bin/sh
# ue-py: the shared UniEnv Python (pinned 3.12) with every installed battery.
# Generated by `unienv sync`. Use it for ad-hoc work outside projects; inside a
# project, use that project's own environment (uv run / .venv/bin/python).
PY="@UNIENV_HOME@/py/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "UniEnv's Python 3.12 interpreter is missing. Repair with: curl -fsSL https://raw.githubusercontent.com/rupeshbharambe24/unienv-ai/main/install.sh | bash" >&2
  exit 1
fi
exec "$PY" "$@"
