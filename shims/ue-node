#!/bin/sh
# ue-node: Node.js with UniEnv's preinstalled packages resolvable via require().
# Generated by `unienv sync`. ESM `import` does not honour NODE_PATH; use
# require() or createRequire(import.meta.url).
NODE_PATH="@UNIENV_HOME@/node/node_modules${NODE_PATH:+:$NODE_PATH}"
export NODE_PATH
exec "@NODE@" "$@"
